#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		kfsw,boton-test-button = &boton_test_test_button;
		kfsw,boton-test-led-green = &boton_test_green_led;
		kfsw,boton-test-led-blue = &boton_test_blue_led;
		kfsw,boton-test-led-red = &boton_test_red_led;
	};

	boton_test_buttons {
		compatible = "gpio-keys";

		boton_test_test_button: button {
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		};
	};

	boton_test_leds {
		compatible = "gpio-leds";

		boton_test_green_led: green_led {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		};

		/* Exercise logical polarity handling with an active-low output. */
		boton_test_blue_led: blue_led {
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		};

		boton_test_red_led: red_led {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gpio0 {
	ngpios = <5>;
};
