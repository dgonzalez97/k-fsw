/ {
	chosen {
		kfsw,storage-partition = &storage_partition;
		kfsw,tmp-disk = &tmp_disk;
	};

	/* RAM volume behind /kfsw/tmp. */
	tmp_disk: tmp-disk {
		compatible = "zephyr,ram-disk";
		disk-name = "TMP";
		sector-size = <512>;
		sector-count = <64>;
	};
};

&storage_partition {
	label = "kfsw-storage-test";
	reg = <0x000fc000 0x00010000>;
};
