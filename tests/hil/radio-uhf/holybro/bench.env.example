# Stable serial path for the USB-connected Holybro unit.
export KGROUND_HOLYBRO_DEVICE=/dev/serial/by-id/usb-HOLYBRO_SIK_RADIO

# NUCLEO ST-LINK virtual COM port used for shell capture and commands.
export KFSW_DEBUG_SERIAL=/dev/serial/by-id/usb-STMicroelectronics_STLINK-V3

# Recorded USB-side RFD SiK 2.0 / HM-TRP settings. These are bench evidence,
# not configuration commands executed by the smoke tests.
export KGROUND_HOLYBRO_BAUD=57600
export KGROUND_HOLYBRO_AIR_SPEED=64
export KGROUND_HOLYBRO_NETID=25
export KGROUND_HOLYBRO_TXPOWER=20
export KGROUND_HOLYBRO_ECC=0
export KGROUND_HOLYBRO_MAVLINK=1
export KGROUND_HOLYBRO_MIN_FREQUENCY_KHZ=433050
export KGROUND_HOLYBRO_MAX_FREQUENCY_KHZ=434790
export KGROUND_HOLYBRO_CHANNELS=10
export KGROUND_HOLYBRO_RTSCTS=0
