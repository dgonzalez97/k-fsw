/* Application-side half of the MCUboot composition. Applied only to the
 * application image, on top of nucleo-mcuboot-flash.overlay.
 *
 * The single 960 KB application partition is removed and the application is
 * linked into the primary slot instead. The bootloader image has no such
 * partition to remove, which is why this is separate from the shared map.
 */

/delete-node/ &kfsw_app_partition;

/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
	};
};
