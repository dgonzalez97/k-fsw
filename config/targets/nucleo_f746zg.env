ZEPHYR_BOARD=nucleo_f746zg

# Two ST-Links are on this bench, so the board is addressed by its own serial
# and never by a /dev/ttyACM path, which swaps between boots.
KFSW_SERIAL="${KFSW_SERIAL:-/dev/serial/by-id/usb-STMicroelectronics_STM32_STLink_066BFF353056363043044156-if02}"
KFSW_SERIAL_BAUD="${KFSW_SERIAL_BAUD:-115200}"

KFSW_STLINK_USB_ID=0483:374b
KFSW_STLINK_SERIAL=066BFF353056363043044156

KFSW_FLASH_RUNNER=openocd
KFSW_EXPECTED_PROMPT='kfsw:~$ '

KFSW_GDB_HOST=localhost
KFSW_GDB_PORT=3334
