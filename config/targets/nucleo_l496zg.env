ZEPHYR_BOARD=nucleo_l496zg

# Two ST-Links are on this bench, so the board is addressed by its own serial
# and never by a /dev/ttyACM path, which swaps between boots.
KFSW_SERIAL="${KFSW_SERIAL:-/dev/serial/by-id/usb-STMicroelectronics_STM32_STLink_0670FF3732504E3043093407-if02}"
KFSW_SERIAL_BAUD="${KFSW_SERIAL_BAUD:-115200}"

KFSW_STLINK_USB_ID=0483:374b
# Two ST-Links are on this bench, so a tool must never pick one for itself.
KFSW_STLINK_SERIAL=0670FF3732504E3043093407

KFSW_GDB_HOST=localhost
KFSW_GDB_PORT=3333
