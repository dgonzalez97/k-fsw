/ {
	chosen {
		zephyr,code-partition = &kfsw_app_partition;
		kfsw,csp-uart = &usart3;
		kfsw,storage-partition = &kfsw_storage_partition;
		/* The RTC counter is not cleared by a reset. */
		kfsw,rtc = &rtc;
		/* watchdog0 names the window watchdog. The independent one has a
		 * longer timeout and runs in most low-power states.
		 */
		kfsw,watchdog = &iwdg;
		kfsw,tmp-disk = &tmp_disk;
	};

	/* 32 KB of SRAM2 behind /kfsw/tmp, formatted at every boot. Nothing else
	 * uses SRAM2, and it keeps its contents across a reset, hence the format.
	 */
	tmp_disk: tmp-disk {
		compatible = "zephyr,ram-disk";
		disk-name = "TMP";
		sector-size = <512>;
		sector-count = <64>;
		ram-region = <&sram1>;
	};
};

&iwdg {
	status = "okay";
};

/* Dedicated CSP/KISS UART. The debug shell remains on LPUART1 PG7/PG8. */
&usart3 {
	label = "usart3";
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		kfsw_app_partition: partition@0 {
			label = "kfsw-app";
			reg = <0x00000000 0x000f0000>;
		};

		kfsw_storage_partition: partition@f0000 {
			label = "kfsw-storage";
			reg = <0x000f0000 0x00010000>;
		};
	};
};
