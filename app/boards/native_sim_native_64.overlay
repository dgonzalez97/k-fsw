&uart1 {
	current-speed = <115200>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	status = "okay";
};

/ {
	chosen {
		kfsw,csp-uart = &uart1;
		kfsw,storage-partition = &storage_partition;
		/* Always set; it costs nothing when the update service is not built in. */
		kfsw,fwu-partition = &slot1_partition;
	};
};

&storage_partition {
	label = "kfsw-storage";
	/* 256 kB, where the NUCLEO has 64, to give the housekeeping file store room.
	 * The simulated flash is 2 MB.
	 */
	reg = <0x000fc000 0x00040000>;
};
