&uart1 {
	current-speed = <115200>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	status = "okay";
};

/ {
	chosen {
		kfsw,csp-uart = &uart1;
		kfsw,storage-partition = &storage_partition;
		/* Bound whether or not the update service is composed in. A
		 * chosen property costs nothing when nothing reads it, and
		 * naming it here keeps the address out of the service. */
		kfsw,fwu-partition = &slot1_partition;
	};
};

&storage_partition {
	label = "kfsw-storage";
	reg = <0x000fc000 0x00010000>;
};
