&uart1 {
	current-speed = <115200>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	status = "okay";
};

/ {
	chosen {
		kfsw,csp-uart = &uart1;
		kfsw,storage-partition = &storage_partition;
		/* Always set; it costs nothing when the update service is not built in. */
		kfsw,fwu-partition = &slot1_partition;
		kfsw,tmp-disk = &tmp_disk;
		kfsw,boot-budget-partition = &kfsw_boot_budget_partition;
	};

	/* 32 KB of RAM behind /kfsw/tmp, formatted at every boot. */
	tmp_disk: tmp-disk {
		compatible = "zephyr,ram-disk";
		disk-name = "TMP";
		sector-size = <512>;
		sector-count = <64>;
	};
};

/* The last 8 kB of the unused swap scratch, so that it stays below the storage
 * partition: a test overlay that grows storage must not land on top of it.
 */
&scratch_partition {
	reg = <0x000de000 0x0001c000>;
};

&flash0 {
	partitions {
		kfsw_boot_budget_partition: partition@fa000 {
			label = "kfsw-boot-budget";
			reg = <0x000fa000 0x00002000>;
		};
	};
};

&storage_partition {
	label = "kfsw-storage";
	/* 256 kB, where the NUCLEO has 64, to give the housekeeping file store room.
	 * The simulated flash is 2 MB.
	 */
	reg = <0x000fc000 0x00040000>;
};
