mainmenu "K-FSW Configuration"

menu "K-FSW application"

config KFSW_ROLE
	string "K-FSW composition role"
	default "flight"
	help
	  Short operator-visible role for this composition, such as flight or
	  ground. This is identity metadata and does not select behavior.

config KFSW_INSTANCE_NAME
	string "K-FSW instance name"
	default "kfsw"
	help
	  Short operator-visible name for this configured K-FSW instance.

config KFSW_DEBUG_SHELL
	bool "K-FSW debug command shell"
	select SHELL
	select SHELL_MINIMAL
	select SHELL_BACKEND_SERIAL
	select SHELL_TAB
	select SHELL_TAB_AUTOCOMPLETION
	select SHELL_HISTORY
	select SHELL_METAKEYS
	select SHELL_HELP
	select SHELL_HELP_ON_WRONG_ARGUMENT_COUNT
	help
	  Enable the serial debug shell and the K-FSW commands. It also turns
	  on usage help for wrong argument counts, which SHELL_MINIMAL disables.
	  Disable it for release builds without an interactive shell.

config KFSW_PARAM_TEST_DEFINITIONS
	bool "Test-only parameter fixture definitions"
	depends on KFSW_PARAM
	help
	  Link integration-only scalar parameter fixtures. Enable this only in
	  software and physical test configurations; normal application
	  compositions contain no test parameters.

config KFSW_HIL_PROBES
	bool "Bench timing and interrupted-update probes"
	depends on KFSW_DEBUG_SHELL && KFSW_HK && KFSW_PARAM && KFSW_FWU
	depends on TIMER_HAS_64BIT_CYCLE_COUNTER && !SMP
	depends on TRACING_USER && INIT_STACKS && THREAD_STACK_INFO
	depends on THREAD_NAME && THREAD_MONITOR
	help
	  Record wake-to-run latency and service durations. The local hil command
	  can arm a reset between secondary-slot erase pages or write blocks.
	  Only enable this in bench images.

endmenu

config SHELL_PROMPT_UART
	default "kfsw:~$ " if KFSW_DEBUG_SHELL

# The prompt is recoloured at runtime, which Kconfig strings cannot express.
config SHELL_PROMPT_CHANGE
	default y if KFSW_DEBUG_SHELL

# Room for the prompt and its colour codes. Zephyr's default of 10 only fits
# the text; 40 is the maximum.
config SHELL_PROMPT_BUFF_SIZE
	default 40 if KFSW_DEBUG_SHELL

source "Kconfig.zephyr"

config KFSW_APP_HEALTH_DEADLINE_MS
	int "How long the application thread may go without reporting"
	depends on KFSW_HEALTH
	default 4000
	range 200 60000
	help
	  The application reports four times per deadline, so a normal
	  scheduling delay doesn't look like a stopped thread.
