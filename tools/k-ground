#!/usr/bin/env bash
set -Eeuo pipefail

KGROUND_TOOL="$(readlink -f "${BASH_SOURCE[0]}")"
KGROUND_TOOLS_DIR="$(dirname "$KGROUND_TOOL")"
KGROUND_REPO_DIR="$(dirname "$KGROUND_TOOLS_DIR")"
KGROUND_WORKSPACE_ROOT="$(dirname "$KGROUND_REPO_DIR")"
KGROUND_PROFILE="$KGROUND_REPO_DIR/config/profiles/k-ground.conf"
KGROUND_BUILD_ROOT="${KGROUND_BUILD_ROOT:-$KGROUND_WORKSPACE_ROOT/build/k-ground}"

usage()
{
	printf '%s\n' \
		'Usage: tools/k-ground <command> [arguments]' \
		'' \
		'Commands:' \
		'  build --node N [--name NAME] [--peer N]' \
		'      Build one Linux ground node (ground addresses start at 16).' \
		'  run --node N [--name NAME] [--peer N] [-- NATIVE_SIM_ARGS...]' \
		'      Build if needed and run one ground node on this terminal.' \
		'  demo' \
		'      Run nodes 16/main and 17/peer with an interactive node-16 shell.' \
		'  test' \
		'      Run the automated bidirectional node-16/node-17 CSP smoke test.' \
		'  help' \
		'      Show this help.'
}

fail()
{
	echo "ERROR: $1" >&2
	exit 1
}

validate_node()
{
	local value="$1"
	local label="$2"

	[[ "$value" =~ ^[1-9][0-9]*$ ]] || \
		fail "$label must be a positive integer without leading zeros"
	(( value >= 1 && value <= 16383 )) || \
		fail "$label must be in the CSP v2 range 1..16383"
}

validate_ground_node()
{
	validate_node "$1" "ground node"
	(( $1 >= 16 )) || fail "ground node addresses start at 16"
}

validate_name()
{
	[[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]{0,31}$ ]] || \
		fail "name must start with a letter and use at most 32 letters, digits, _ or -"
}

parse_node_options()
{
	ground_node=""
	ground_name=""
	ground_peer=""
	native_arguments=()

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--node)
			[[ $# -ge 2 ]] || fail "--node requires an address"
			ground_node="$2"
			shift 2
			;;
		--name)
			[[ $# -ge 2 ]] || fail "--name requires a value"
			ground_name="$2"
			shift 2
			;;
		--peer)
			[[ $# -ge 2 ]] || fail "--peer requires an address"
			ground_peer="$2"
			shift 2
			;;
		--)
			shift
			native_arguments=("$@")
			break
			;;
		*)
			fail "unknown argument: $1"
			;;
		esac
	done

	[[ -n "$ground_node" ]] || fail "--node is required"
	validate_ground_node "$ground_node"

	if [[ -z "$ground_name" ]]; then
		if [[ "$ground_node" == 16 ]]; then
			ground_name="main"
		else
			ground_name="node-$ground_node"
		fi
	fi
	validate_name "$ground_name"

	if [[ -z "$ground_peer" ]]; then
		if [[ "$ground_node" == 16 ]]; then
			ground_peer=17
		else
			ground_peer=16
		fi
	fi
	validate_node "$ground_peer" "peer node"
	[[ "$ground_node" != "$ground_peer" ]] || \
		fail "ground node and peer node must differ"
}

write_ground_config()
{
	local config_dir="$KGROUND_BUILD_ROOT/config"
	local config_file="$config_dir/node-$ground_node.conf"

	mkdir -p "$config_dir" || fail "cannot create ground configuration directory"
	cp "$KGROUND_PROFILE" "$config_file" || fail "cannot create generated ground configuration"
	{
		printf '\n# Generated by tools/k-ground.\n'
		printf 'CONFIG_KFSW_INSTANCE_NAME="%s"\n' "$ground_name"
		printf 'CONFIG_KFSW_CSP_ADDRESS=%s\n' "$ground_node"
		printf 'CONFIG_KFSW_CSP_HOSTNAME="k-ground-%s"\n' "$ground_name"
		printf 'CONFIG_KFSW_CSP_UART_PEER_ADDRESS=%s\n' "$ground_peer"
	} >>"$config_file" || fail "cannot write generated ground configuration"

	printf '%s\n' "$config_file"
}

build_ground_node()
{
	local build_dir="$KGROUND_BUILD_ROOT/node-$ground_node"
	local config_file

	config_file="$(write_ground_config)"

	echo "K-GROUND BUILD: node=$ground_node name=$ground_name peer=$ground_peer"
	KFSW_BUILD_DIR="$build_dir" \
		KFSW_EXTRA_CONF_FILE="$config_file" \
		"$KGROUND_TOOLS_DIR/build.sh" linux
}

run_ground_node()
{
	local build_dir="$KGROUND_BUILD_ROOT/node-$ground_node"
	local executable="$build_dir/zephyr/zephyr.exe"
	local has_flash_path=false
	local argument
	local -a flash_arguments=()

	build_ground_node
	[[ -x "$executable" ]] || fail "ground executable was not produced"

	for argument in "${native_arguments[@]}"; do
		if [[ "$argument" == -flash=* ]]; then
			has_flash_path=true
			break
		fi
	done

	if ! $has_flash_path; then
		flash_arguments+=("-flash=$build_dir/k-ground-storage.bin")
	fi

	exec "$executable" --uart_stdinout --device_id="$ground_node" \
		"${flash_arguments[@]}" "${native_arguments[@]}"
}

command="${1:-}"
[[ -n "$command" ]] && shift || true

case "$command" in
build)
	parse_node_options "$@"
	[[ ${#native_arguments[@]} -eq 0 ]] || fail "build does not accept native_sim arguments"
	build_ground_node
	;;
run)
	parse_node_options "$@"
	run_ground_node
	;;
demo)
	[[ $# -eq 0 ]] || fail "demo does not accept arguments"
	exec "$KGROUND_REPO_DIR/tests/k-ground-csp-smoke.sh" --terminal
	;;
test)
	[[ $# -eq 0 ]] || fail "test does not accept arguments"
	exec "$KGROUND_REPO_DIR/tests/k-ground-csp-smoke.sh"
	;;
help|-h|--help)
	usage
	;;
"")
	usage
	exit 1
	;;
*)
	fail "unknown command: $command"
	;;
esac
