#!/usr/bin/env bash
set -Eeuo pipefail

KGROUND_TOOL="$(readlink -f "${BASH_SOURCE[0]}")"
KGROUND_TOOLS_DIR="$(dirname "$KGROUND_TOOL")"
KGROUND_REPO_DIR="$(dirname "$KGROUND_TOOLS_DIR")"
KGROUND_WORKSPACE_ROOT="$(dirname "$KGROUND_REPO_DIR")"
KGROUND_PROFILE="$KGROUND_REPO_DIR/config/profiles/k-ground.conf"
KGROUND_DEFAULT_STATION="$KGROUND_REPO_DIR/ground-station"
KGROUND_BUILD_ROOT="${KGROUND_BUILD_ROOT:-$KGROUND_WORKSPACE_ROOT/build/k-ground}"

usage()
{
	printf '%s\n' \
		'Usage: tools/k-ground <command> [arguments]' \
		'' \
		'Commands:' \
		'  init [DIRECTORY]' \
		'      Create a small ground-station configuration (default: ./ground-station).' \
		'  build ROLE [--node N] [--peer N]' \
		'      Build one configured Linux ground role.' \
		'  run ROLE [--node N] [--peer N] [--no-local-link] [-- NATIVE_ARGS...]' \
		'      Run one role; ground peers rendezvous over a local KISS link.' \
		'  demo' \
		'      Run kfsw-gnd-uhf (16) and kfsw-ops (19) with an ops shell.' \
		'  test' \
		'      Verify the configured node-16/node-19 link in both directions.' \
		'  help' \
		'      Show this help.'
}

fail()
{
	echo "ERROR: $1" >&2
	exit 1
}

validate_node()
{
	local value="$1"
	local label="$2"

	[[ "$value" =~ ^[1-9][0-9]*$ ]] || \
		fail "$label must be a positive integer without leading zeros"
	(( value >= 1 && value <= 16383 )) || \
		fail "$label must be in the CSP v2 range 1..16383"
}

validate_ground_node()
{
	validate_node "$1" "ground node"
	(( $1 >= 16 )) || fail "ground node addresses start at 16"
}

validate_role()
{
	[[ "$1" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || \
		fail "role must use at most 32 lowercase letters, digits, and hyphens"
}

resolve_station_dir()
{
	if [[ -n "${KGROUND_STATION_DIR:-}" ]]; then
		station_dir="$(readlink -f "$KGROUND_STATION_DIR")"
	elif [[ -f "$PWD/ground-station/nodes/$role_key.env" ]]; then
		station_dir="$(readlink -f "$PWD/ground-station")"
	else
		station_dir="$KGROUND_DEFAULT_STATION"
	fi
}

load_role_config()
{
	local config_file

	validate_role "$role_key"
	resolve_station_dir
	config_file="$station_dir/nodes/$role_key.env"
	[[ -f "$config_file" ]] || \
		fail "ground role is not configured: $role_key ($config_file)"

	unset KFSW_ROLE KFSW_NAME KFSW_CSP_NODE KFSW_CSP_PEER KFSW_CSP_ROUTES \
		KFSW_RADIO_UHF
	# Node files are deliberately simple shell-compatible environment files.
	set -a
	# shellcheck disable=SC1090
	source "$config_file"
	set +a

	ground_role="${KFSW_ROLE:-$role_key}"
	ground_name="${KFSW_NAME:-$ground_role}"
	ground_node="${KFSW_CSP_NODE:-}"
	ground_peer="${KFSW_CSP_PEER:-}"
	ground_routes="${KFSW_CSP_ROUTES:-}"
	ground_radio_uhf="${KFSW_RADIO_UHF:-}"

	validate_role "$ground_role"
	[[ "$ground_role" == "$role_key" ]] || \
		fail "$config_file sets KFSW_ROLE=$ground_role but was selected as $role_key"
	validate_role "$ground_name"
	[[ -n "$ground_node" ]] || fail "$config_file does not set KFSW_CSP_NODE"
	[[ -n "$ground_peer" ]] || fail "$config_file does not set KFSW_CSP_PEER"
	[[ -z "$ground_radio_uhf" || "$ground_radio_uhf" == "holybro" ]] || \
		fail "$config_file selects unsupported KFSW_RADIO_UHF=$ground_radio_uhf"
	[[ ${#ground_routes} -le 99 ]] || \
		fail "$config_file KFSW_CSP_ROUTES exceeds libcsp's 99-character limit"
	[[ -z "$ground_routes" || "$ground_routes" =~ ^[A-Za-z0-9_/,\ -]+$ ]] || \
		fail "$config_file KFSW_CSP_ROUTES contains unsupported characters"
}

parse_role_options()
{
	[[ $# -ge 1 ]] || fail "a configured ground ROLE is required"
	role_key="$1"
	shift
	load_role_config

	node_override=""
	peer_override=""
	local_link=true
	native_arguments=()

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--node)
			[[ $# -ge 2 ]] || fail "--node requires an address"
			node_override="$2"
			shift 2
			;;
		--peer)
			[[ $# -ge 2 ]] || fail "--peer requires an address"
			peer_override="$2"
			shift 2
			;;
		--no-local-link)
			local_link=false
			shift
			;;
		--)
			shift
			native_arguments=("$@")
			break
			;;
		*)
			fail "unknown argument: $1"
			;;
		esac
	done

	[[ -z "$node_override" ]] || ground_node="$node_override"
	[[ -z "$peer_override" ]] || ground_peer="$peer_override"
	validate_ground_node "$ground_node"
	validate_node "$ground_peer" "peer node"
	[[ "$ground_node" != "$ground_peer" ]] || \
		fail "ground node and peer node must differ"
}

write_ground_config()
{
	local config_dir="$KGROUND_BUILD_ROOT/config"
	local config_file="$config_dir/node-$ground_node.conf"

	mkdir -p "$config_dir" || fail "cannot create ground configuration directory"
	cp "$KGROUND_PROFILE" "$config_file" || fail "cannot create generated ground configuration"
	{
		printf '\n# Generated by tools/k-ground from %s.\n' "$role_key.env"
		printf 'CONFIG_KFSW_ROLE="%s"\n' "$ground_role"
		printf 'CONFIG_KFSW_INSTANCE_NAME="%s"\n' "$ground_name"
		printf 'CONFIG_SHELL_PROMPT_UART="%s# "\n' "$ground_role"
		printf 'CONFIG_KFSW_CSP_ADDRESS=%s\n' "$ground_node"
		printf 'CONFIG_KFSW_CSP_HOSTNAME="%s"\n' "$ground_role"
		printf 'CONFIG_KFSW_CSP_UART_PEER_ADDRESS=%s\n' "$ground_peer"
		if [[ -n "$ground_routes" ]]; then
			printf 'CONFIG_KFSW_CSP_ROUTE_TABLE="%s"\n' "$ground_routes"
		fi
		if [[ "$ground_radio_uhf" == "holybro" ]]; then
			printf 'CONFIG_KFSW_RADIO_UHF=y\n'
			printf 'CONFIG_KFSW_RADIO_UHF_HOLYBRO=y\n'
			printf 'CONFIG_KFSW_RADIO_UHF_EXPECTED_SERIAL_BAUD=57600\n'
		fi
	} >>"$config_file" || fail "cannot write generated ground configuration"

	printf '%s\n' "$config_file"
}

build_ground_node()
{
	local build_dir="$KGROUND_BUILD_ROOT/node-$ground_node"
	local config_file

	config_file="$(write_ground_config)"

	echo "K-GROUND BUILD: role=$ground_role node=$ground_node peer=$ground_peer"
	KFSW_BUILD_DIR="$build_dir" \
		KFSW_EXTRA_CONF_FILE="$config_file" \
		"$KGROUND_TOOLS_DIR/build.sh" linux
}

wait_for_output()
{
	local file="$1"
	local expected="$2"
	local process_pid="$3"

	for _ in {1..300}; do
		grep -Fq "$expected" "$file" 2>/dev/null && return 0
		kill -0 "$process_pid" 2>/dev/null || return 1
		sleep 0.05
	done
	return 1
}

run_ground_node()
{
	local build_dir="$KGROUND_BUILD_ROOT/node-$ground_node"
	local executable="$build_dir/zephyr/zephyr.exe"
	local work_dir
	local input_fifo
	local output_log
	local node_pid=""
	local relay_pid=""
	local bridge_pid=""
	local link_socket=""
	local ground_pty
	local low_node
	local high_node
	local exit_code
	local has_flash_path=false
	local argument
	local -a flash_arguments=()

	build_ground_node
	[[ -x "$executable" ]] || fail "ground executable was not produced"
	command -v socat >/dev/null 2>&1 || fail "socat is required"

	for argument in "${native_arguments[@]}"; do
		if [[ "$argument" == -flash=* ]]; then
			has_flash_path=true
			break
		fi
	done
	if ! $has_flash_path; then
		flash_arguments+=("-flash=$build_dir/k-ground-storage.bin")
	fi

	work_dir="$(mktemp -d "/tmp/k-ground-run.${ground_role}.XXXXXX")"
	input_fifo="$work_dir/input"
	output_log="$work_dir/output.log"
	mkfifo "$input_fifo"
	exec 3<>"$input_fifo"

	cleanup_run()
	{
		[[ -n "$bridge_pid" ]] && kill "$bridge_pid" 2>/dev/null || true
		[[ -n "$relay_pid" ]] && kill "$relay_pid" 2>/dev/null || true
		[[ -n "$node_pid" ]] && kill "$node_pid" 2>/dev/null || true
		wait 2>/dev/null || true
		exec 3>&- 2>/dev/null || true
		if [[ -n "$link_socket" && "$ground_node" -lt "$ground_peer" ]]; then
			rm -f -- "$link_socket"
		fi
		rm -rf -- "$work_dir"
	}
	trap cleanup_run EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM

	"$executable" --uart_stdinout --device_id="$ground_node" \
		"${flash_arguments[@]}" "${native_arguments[@]}" \
		<&3 >"$output_log" 2>&1 &
	node_pid=$!
	tail -n +1 -F "$output_log" &
	relay_pid=$!

	wait_for_output "$output_log" "@READY " "$node_pid" || \
		fail "$ground_role did not report readiness"
	wait_for_output "$output_log" "uart_1 connected to pseudotty: " "$node_pid" || \
		fail "$ground_role did not expose its CSP UART"
	ground_pty="$(sed -n 's/^uart_1 connected to pseudotty: //p' \
		"$output_log" | head -1)"

	if $local_link && (( ground_peer >= 16 )); then
		mkdir -p "$KGROUND_BUILD_ROOT/runtime"
		if (( ground_node < ground_peer )); then
			low_node="$ground_node"
			high_node="$ground_peer"
		else
			low_node="$ground_peer"
			high_node="$ground_node"
		fi
		link_socket="$KGROUND_BUILD_ROOT/runtime/link-${low_node}-${high_node}.sock"

		if (( ground_node < ground_peer )); then
			rm -f -- "$link_socket"
			echo "K-GROUND LOCAL LINK: listening for node $ground_peer"
			socat "$ground_pty,raw,echo=0" \
				"UNIX-LISTEN:$link_socket" &
			bridge_pid=$!
		else
			echo "K-GROUND LOCAL LINK: waiting for node $ground_peer"
			(
				for _ in {1..1200}; do
					if [[ -S "$link_socket" ]]; then
						exec socat "$ground_pty,raw,echo=0" \
							"UNIX-CONNECT:$link_socket"
					fi
					sleep 0.05
				done
				echo "K-GROUND LOCAL LINK: timed out waiting for node $ground_peer" >&2
				exit 1
			) &
			bridge_pid=$!
		fi
	fi

	# Keep the terminal relay in the foreground.  A background process that
	# reads from an interactive terminal can be stopped by SIGTTIN, leaving a
	# prompt that echoes input without delivering it to the Zephyr shell.
	cat >&3
	set +e
	wait "$node_pid"
	exit_code=$?
	set -e
	cleanup_run
	trap - EXIT INT TERM
	return "$exit_code"
}

init_ground_station()
{
	local target="${1:-$PWD/ground-station}"

	[[ $# -le 1 ]] || fail "init accepts at most one directory"
	[[ ! -e "$target" ]] || fail "ground-station path already exists: $target"
	mkdir -p "$target"
	cp -R "$KGROUND_DEFAULT_STATION/." "$target/"
	echo "K-GROUND INIT: $target"
	echo "  Set KGROUND_STATION_DIR=$target or run from its parent directory."
}

command="${1:-}"
[[ -n "$command" ]] && shift || true

case "$command" in
init)
	init_ground_station "$@"
	;;
build)
	parse_role_options "$@"
	[[ ${#native_arguments[@]} -eq 0 ]] || fail "build does not accept native_sim arguments"
	build_ground_node
	;;
run)
	parse_role_options "$@"
	run_ground_node
	;;
demo)
	[[ $# -eq 0 ]] || fail "demo does not accept arguments"
	exec "$KGROUND_REPO_DIR/tests/k-ground-csp-smoke.sh" --terminal
	;;
test)
	[[ $# -eq 0 ]] || fail "test does not accept arguments"
	exec "$KGROUND_REPO_DIR/tests/k-ground-csp-smoke.sh"
	;;
help|-h|--help)
	usage
	;;
"")
	usage
	exit 1
	;;
*)
	fail "unknown command: $command"
	;;
esac
