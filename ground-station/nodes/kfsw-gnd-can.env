# Ground node that reaches a flight node over CAN.
#
# Pass the SocketCAN interface at run time with --can-if. Bring it up first:
#
#   sudo k-fsw/tests/hil/stm32/nucleo-l496zg/can-up.sh 500000 normal
KFSW_ROLE=kfsw-gnd-can
KFSW_CSP_NODE=16
KFSW_CSP_PEER=2

# Everything goes over CAN; this node has no serial link.
KFSW_CSP_ROUTES='0/0 CAN'

KFSW_EXTRA_OVERLAY=config/profiles/k-ground-can.overlay
KFSW_EXTRA_KCONFIG='CONFIG_POSIX_API=y
CONFIG_POSIX_TIMERS=y
CONFIG_CAN=y
CONFIG_KFSW_CSP_CAN=y
CONFIG_KFSW_CSP_CAN_INTERFACE_NAME="CAN"
CONFIG_KFSW_CSP_CAN_BITRATE=500000
CONFIG_KFSW_CSP_CAN_PREFIX_LENGTH=0'
