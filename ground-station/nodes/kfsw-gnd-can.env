# Ground node that reaches a flight node over CAN rather than a radio.
#
# The adapter is whatever SocketCAN interface the host brought up; pass it at
# run time with --can-if, since the same build should serve can0, vcan0 or a
# second adapter without rebuilding.
#
# Bring the host interface up first. A CAN transmitter needs another node to
# acknowledge its frames, so a node talking to a bus nobody is on accumulates
# errors rather than waiting quietly:
#
#   sudo k-fsw/tests/hil/can/up.sh 500000 normal
KFSW_ROLE=kfsw-gnd-can
KFSW_CSP_NODE=16
KFSW_CSP_PEER=2

# Everything goes over CAN. There is no serial link on this node, so a default
# route through KISS would send traffic into an interface that does not exist.
KFSW_CSP_ROUTES='0/0 CAN'

KFSW_EXTRA_OVERLAY=config/profiles/k-ground-can.overlay
KFSW_EXTRA_KCONFIG='CONFIG_CAN=y
CONFIG_KFSW_CSP_CAN=y
CONFIG_KFSW_CSP_CAN_INTERFACE_NAME="CAN"
CONFIG_KFSW_CSP_CAN_BITRATE=500000
CONFIG_KFSW_CSP_CAN_PREFIX_LENGTH=0'
