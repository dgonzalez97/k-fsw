/* The repository layout, rendered to SVG by tools/docs/diagrams.sh.
 *
 * Colours are given for both themes by using mid-tones that hold on a white
 * page and a dark one, since GitHub picks the reader's theme and an SVG cannot
 * ask which it got.
 */
digraph kfsw {
	bgcolor="transparent";
	rankdir=TB;
	node [shape=box, style="rounded,filled", fontname="Helvetica",
	      fontsize=11, color="#43a0b2", fillcolor="#e8f2f5", fontcolor="#173345",
	      margin="0.18,0.10"];
	edge [color="#78909c", arrowsize=0.7];

	app [label=<<b>k-fsw</b><br/>composition, targets, tools, tests, docs>,
	     fillcolor="#294c69", fontcolor="#ffffff", color="#294c69"];

	modules  [label=<<b>kfsw-modules</b><br/>radio, GNSS, sensors, I/O>];
	services [label=<<b>kfsw-services</b><br/>log, param, files, events,<br/>commands, health, update>];
	comms    [label=<<b>kfsw-comms</b><br/>CSP, routing, KISS, CAN>];
	platform [label=<<b>kfsw-platform</b><br/>time, storage, reset cause,<br/>watchdog>];

	zephyr [label=<<b>Zephyr</b><br/>kernel, devices, drivers, build>,
	        fillcolor="#e0e9ef", color="#91a4b2", fontcolor="#253d4b"];

	app -> {modules services comms platform};
	{modules services comms platform} -> zephyr;

	{rank=same; modules; services; comms; platform;}
}
