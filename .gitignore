# Bench files with the device paths of one machine. The template is
# tests/hil/radio-uhf/holybro/bench.env.example.
bench.env
*-bench.env

# Python bytecode from the ground tools
__pycache__/
*.pyc

# Output from direct Twister runs
twister-out*/

# native_sim flash images left by a hosted run
flash.bin

# Local firmware upload artifacts at the checkout root
/firmware.bin
/.fwu-test-*.bin
